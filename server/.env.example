# ============================================================
# VibeCheck Backend — Environment Configuration Template
# ============================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Connection (Provided automatically by Coolify PostgreSQL resource)
# Example: postgresql://postgres:securepassword@postgres:5432/vibecheck_prod
DATABASE_URL=

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBED_MODEL=text-embedding-004

# WhatsApp Business API Credentials (for OTP & RSVPs)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_OTP_TEMPLATE_NAME=vibecheck_otp_template
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true


# Allowed CORS Origins & Web URL
ALLOWED_ORIGINS=http://localhost:3500,https://vibecheck-uat.vercel.app,https://vibecheckspace.com
WEB_APP_URL=https://vibecheck-uat.vercel.app

# Private Backend Token (Smart Proxy Auth)
PRIVATE_BACKEND_TOKEN=your_secure_random_token_here
