# ============================================================
# VibeCheck Backend — Environment Configuration Template
# ============================================================

# Server Configuration
PORT=4000
NODE_ENV=production

# Database Connection (Provided automatically by Coolify PostgreSQL resource)
# Example: postgresql://postgres:securepassword@postgres:5432/vibecheck_prod
DATABASE_URL=

# AI Model Mode: 'local' (Ollama) or 'cloud' (Gemini Flash)
# Set to 'cloud' for production hosting (lightweight/no local GPU needed)
RUN_MODE=cloud

# Required only when RUN_MODE=cloud
GEMINI_API_KEY=your_gemini_api_key_here

# WhatsApp Business API Credentials (for OTP & RSVPs)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Optional: Email Service credentials (if Resend is used)
RESEND_API_KEY=your_resend_api_key
