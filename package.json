{
  "name": "vibecheck-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:server && npm run test:web",
    "test:server": "npm --prefix server test",
    "test:web": "npm --prefix web test",
    "test:watch:server": "npm --prefix server run test:watch",
    "test:watch:web": "npm --prefix web run test:watch",
    "test:ui:server": "npm --prefix server run test:ui",
    "test:ui:web": "npm --prefix web run test:ui",
    "lint": "npm --prefix web run lint"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.11"
  }
}
